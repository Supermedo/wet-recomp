+uint32_t WindowSDL::QueryMouseButtons() const {
+  float x = 0.0f;
+  float y = 0.0f;
+  SDL_MouseButtonFlags flags = SDL_GetMouseState(&x, &y);
+  uint32_t mask = 0;
+  if (flags & SDL_BUTTON_LMASK) {
+    mask |= 1u;
+  }
+  if (flags & SDL_BUTTON_RMASK) {
+    mask |= 2u;
+  }
+  if (flags & SDL_BUTTON_MMASK) {
+    mask |= 4u;
+  }
+  return mask;
+}
